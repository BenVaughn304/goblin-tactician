<!DOCTYPE html>
<html>
<head>
  <title>Tactician – Goblin Engine</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #121212;
      color: white;
      padding: 20px;
    }

    h1 {
      color: #7dd3fc;
    }

    .card {
      background: #1f1f1f;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
    }

    input, select {
      margin: 5px 0;
      padding: 5px;
      width: 100%;
    }

    button {
      padding: 10px;
      background: #7dd3fc;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }

    .output {
      background: #0f172a;
      padding: 15px;
      border-radius: 10px;
    }
  </style>
</head>

<body>

<h1>Goblin Tactical Engine</h1>

<div class="card">
  <label>Current HP</label>
  <input type="number" id="hp" value="7">

  <label>Distance to Target (ft)</label>
  <input type="number" id="distance" value="40">

  <label>In Melee?</label>
  <select id="melee">
    <option value="false">No</option>
    <option value="true">Yes</option>
  </select>

  <label>Hidden?</label>
  <select id="hidden">
    <option value="false">No</option>
    <option value="true">Yes</option>
  </select>

  <label>Target 3/4 Cover?</label>
  <select id="cover">
    <option value="false">No</option>
    <option value="true">Yes</option>
  </select>

  <label>Another Target Visible?</label>
  <select id="another">
    <option value="true">Yes</option>
    <option value="false">No</option>
  </select>

  <label>Target HP State</label>
  <select id="targetHP">
    <option value="healthy">Healthy</option>
    <option value="bloodied">Bloodied</option>
    <option value="nearDeath">Near Death</option>
  </select>

  <button onclick="runEngine()">Calculate Behavior</button>
</div>

<div class="output" id="output"></div>

<script>
// Paste Goblin Engine JS here (from previous section)

function runEngine() {
  const state = {
    currentHP: parseInt(document.getElementById("hp").value),
    distanceToTarget: parseInt(document.getElementById("distance").value),
    inMelee: document.getElementById("melee").value === "true",
    hidden: document.getElementById("hidden").value === "true",
    targetHasThreeQuartersCover: document.getElementById("cover").value === "true",
    anotherTargetVisible: document.getElementById("another").value === "true",
    targetHPState: document.getElementById("targetHP").value
  };

  const personality = {
    selfPreservation: 9,
    aggression: 5,
    greed: 6,
    tacticalDiscipline: 6
  };

  const decision = calculateGoblinBehavior(state, personality);

  document.getElementById("output").innerHTML = `
    <h2>${decision.mode}</h2>
    <p><strong>Action:</strong> ${decision.action}</p>
    <p><strong>Movement:</strong> ${decision.movement}</p>
    <p><strong>Bonus Action:</strong> ${decision.bonusAction}</p>
    <p><strong>Reasoning:</strong></p>
    <ul>${decision.reasoning.map(r => `<li>${r}</li>`).join("")}</ul>
  `;
}
</script>

</body>
</html>
// ===============================
// Multi-Goblin Encounter System
// ===============================

let encounter = [];
let personalityPresets = JSON.parse(localStorage.getItem("goblinPresets")) || {};

function addGoblin() {
  const goblin = {
    id: Date.now(),
    name: "Goblin " + (encounter.length + 1),
    currentHP: 7,
    distanceToTarget: 40,
    inMelee: false,
    hidden: false,
    targetHasThreeQuartersCover: false,
    anotherTargetVisible: true,
    targetHPState: "healthy"
  };

  encounter.push(goblin);
  renderEncounter();
}

function removeGoblin(id) {
  encounter = encounter.filter(g => g.id !== id);
  renderEncounter();
}
// ===============================
// Personality Preset System
// ===============================

function savePreset() {
  const name = prompt("Enter preset name:");
  if (!name) return;

  const preset = {
    selfPreservation: parseInt(document.getElementById("selfPreservation").value),
    aggression: parseInt(document.getElementById("aggression").value),
    greed: parseInt(document.getElementById("greed").value),
    tacticalDiscipline: parseInt(document.getElementById("tacticalDiscipline").value)
  };

  personalityPresets[name] = preset;
  localStorage.setItem("goblinPresets", JSON.stringify(personalityPresets));
  renderPresets();
}

function loadPreset(name) {
  const preset = personalityPresets[name];
  if (!preset) return;

  document.getElementById("selfPreservation").value = preset.selfPreservation;
  document.getElementById("aggression").value = preset.aggression;
  document.getElementById("greed").value = preset.greed;
  document.getElementById("tacticalDiscipline").value = preset.tacticalDiscipline;
}

function renderPresets() {
  const container = document.getElementById("presetList");
  container.innerHTML = "";

  Object.keys(personalityPresets).forEach(name => {
    container.innerHTML += `
      <button onclick="loadPreset('${name}')">${name}</button>
    `;
  });
}
function renderEncounter() {
  const board = document.getElementById("encounterBoard");
  board.innerHTML = "";

  encounter.forEach(goblin => {
    board.innerHTML += `
      <div class="card">
        <h3>${goblin.name}</h3>
        HP: <input type="number" value="${goblin.currentHP}"
          onchange="updateGoblin(${goblin.id}, 'currentHP', this.value)">
        Distance: <input type="number" value="${goblin.distanceToTarget}"
          onchange="updateGoblin(${goblin.id}, 'distanceToTarget', this.value)">
        <button onclick="runGoblin(${goblin.id})">Run AI</button>
        <button onclick="removeGoblin(${goblin.id})">Remove</button>
        <div id="output-${goblin.id}"></div>
      </div>
    `;
  });
}

function updateGoblin(id, field, value) {
  const goblin = encounter.find(g => g.id === id);
  goblin[field] = isNaN(value) ? value : parseInt(value);
}
function runGoblin(id) {
  const goblin = encounter.find(g => g.id === id);

  const personality = {
    selfPreservation: parseInt(document.getElementById("selfPreservation").value),
    aggression: parseInt(document.getElementById("aggression").value),
    greed: parseInt(document.getElementById("greed").value),
    tacticalDiscipline: parseInt(document.getElementById("tacticalDiscipline").value)
  };

  const decision = calculateGoblinBehavior(goblin, personality);

  document.getElementById(`output-${id}`).innerHTML = `
    <strong>${decision.mode}</strong><br>
    Action: ${decision.action}<br>
    Movement: ${decision.movement}<br>
    Bonus: ${decision.bonusAction}<br>
    <ul>${decision.reasoning.map(r => `<li>${r}</li>`).join("")}</ul>
  `;
}
<button onclick="addGoblin()">Add Goblin</button>

<h2>Encounter Board</h2>
<div id="encounterBoard"></div>

<h2>Personality Sliders</h2>

Self Preservation:
<input type="range" id="selfPreservation" min="1" max="10" value="9">

Aggression:
<input type="range" id="aggression" min="1" max="10" value="5">

Greed:
<input type="range" id="greed" min="1" max="10" value="6">

Tactical Discipline:
<input type="range" id="tacticalDiscipline" min="1" max="10" value="6">

<br><br>
<button onclick="savePreset()">Save Preset</button>

<div id="presetList"></div>
renderPresets();


{
  "name": "Goblin Tactician",
  "short_name": "Tactician",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#7dd3fc",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}

const CACHE_NAME = "goblin-tactician-v1";
const urlsToCache = [
  "./",
  "./index.html",
  "./manifest.json"
];

self.addEventListener("install", event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => cache.addAll(urlsToCache))
  );
});

self.addEventListener("fetch", event => {
  event.respondWith(
    caches.match(event.request)
      .then(response => response || fetch(event.request))
  );
});
